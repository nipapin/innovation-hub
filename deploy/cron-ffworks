# Расписание сервера ffworks. Ставится под root:  crontab -e
#
# Файл лежит в репозитории как образец — cron его не читает сам.
# Проверить, что стоит сейчас:  crontab -l
#
# ── Почему PATH прописан явно
#
# У cron окружение почти пустое: PATH обычно /usr/bin:/bin, и `node`,
# поставленный через nvm или в /usr/local, оттуда не виден. Задание молча не
# запускается — «пустой вывод» выглядит точно так же, как «всё прошло хорошо».
# Подставьте свой путь: узнать его на сервере командой  which node
PATH=/usr/local/bin:/usr/bin:/bin
SHELL=/bin/bash

# ── Резервная копия базы ────────────────────────────────────────────────────
#
# Раз в сутки в 03:20. Снимает pg_dump, жмёт, кладёт в R2 под
# system/db-backups/, удаляет копии старше 14 дней (--keep N меняет глубину).
#
# Требует на сервере postgresql-client НЕ СТАРШЕ базы:
#   apt install postgresql-client-18     # база — PostgreSQL 18.6
#   pg_dump --version                    # проверить
#
# Подключение и ключи берутся из /root/ffworks/.env, поэтому важен `cd`.
20 3 * * * cd /root/ffworks && node scripts/db-backup.mjs >> /var/log/ffworks-db-backup.log 2>&1

# ── Тик автопостинга ────────────────────────────────────────────────────────
#
# Продвигает очередь публикаций и обходит папки-источники. Период — минута-две:
# сам обход ходит реже (настраивается в разделе «Автопостинг»), а тик ещё и
# двигает очередь. Секрет — из .env, той же строкой CRON_SECRET.
# * * * * * curl -fsS -X POST -H "Authorization: Bearer ЗДЕСЬ_CRON_SECRET" https://ffworks.pro/api/cron/post-queue > /dev/null

# ── Уборка хранилища ────────────────────────────────────────────────────────
#
# * * * * * curl -fsS -X POST -H "Authorization: Bearer ЗДЕСЬ_CRON_SECRET" https://ffworks.pro/api/cron/storage-jobs > /dev/null

# ── Если задания уже заведены ───────────────────────────────────────────────
#
# Два curl'а выше закомментированы намеренно: скорее всего они уже стоят.
# Дублировать их нельзя — два тика подряд означают вдвое более частый обход.
# Сверьтесь с `crontab -l` и добавьте только строку резервной копии.
