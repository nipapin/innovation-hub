# --- Database -------------------------------------------------------------
# Either set the discrete PG* variables...
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=5432
PGDATABASE=
# ...or use a single connection string instead:
# DB_CONNECTION_STRING=postgres://user:pass@host:5432/db?sslmode=require

# Optional pool tuning
# PG_POOL_MAX=3
# PG_POOL_IDLE_MS=10000
# PG_POOL_CONN_MS=30000   # raise for slow remote hosts (default 30s when PGHOST is not localhost)

# Optional TLS
# PGSSLMODE=require            # disable | no-verify | require | verify-ca | verify-full
# Local dev against a remote host with a self-signed cert (e.g. Timeweb):
# PGSSLMODE=no-verify
# PGSSLROOTCERT=/path/root.crt
# PGSSL_CA="-----BEGIN CERTIFICATE-----\n..."
# PGSSL_REJECT_UNAUTHORIZED=1

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Мастер-ключ сейфа: им шифруются ключи внешних сервисов (docs/VENDOR_SERVICES_PLAN.md).
# 32 байта в base64 или hex: `openssl rand -base64 32`.
# Живёт ТОЛЬКО здесь: в базе лежит шифротекст, поэтому её дамп сам по себе не утечка.
# Потеря ключа = потеря всех записанных секретов, их придётся завести заново.
VAULT_MASTER_KEY=

# Bootstrapped on `pnpm db:init` (also creates / promotes this user to ADMIN)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME="Platform Admin"

# --- Sign in with Google (optional) ---------------------------------------
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:3000, https://innohub.example.com
#   Authorized redirect URIs:
#     http://localhost:3000/api/auth/google/callback
#     https://innohub.example.com/api/auth/google/callback
# When both vars are set, a "Continue with Google" button appears on /login + /register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Drive (legacy one-time migration only) ------------------------
# NOT used at runtime. Only for `node scripts/migrate-drive-to-r2.mjs`.
# Safe to leave unset in production after migration.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Optional upload size cap for project media (bytes). Default 250 MB.
# PROJECT_MEDIA_UPLOAD_MAX_BYTES=262144000

# --- S3 / Cloudflare R2 (project files + automation JSON) ---------------
# Primary storage for the account workspace. Object key layout:
#   projects/{userId}/{projectId}/project-meta.json
#   projects/{userId}/{projectId}/options/folderState.json
#   projects/{userId}/{projectId}/options/options.json
#   projects/{userId}/{projectId}/{folderPath}/{uuid}-{name}
#
# For R2: set AWS_ENDPOINT_URL to https://<accountid>.r2.cloudflarestorage.com
AWS_S3_BUCKET=
AWS_REGION=auto
AWS_ENDPOINT_URL=

# Credentials. Any of the following name pairs is accepted:
S3_KEY_ID=
S3_SECRET_KEY=
# AWS_KEY_ID= / AWS_SECRET_KEY=
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=

# Legacy Timeweb source for the one-time `migrate-object-storage-to-r2` script.
# The runtime application never reads these variables.
TW_S3_URL=
TW_S3_BUCKET=
TW_S3_ACCESS_KEY=
TW_S3_SECRET_KEY=

# Optional public CDN base for serving uploaded media directly:
# NEXT_PUBLIC_S3_PUBLIC_BASE_URL=https://cdn.example.com

# Public site URL for links in outgoing notifications (not localhost). On Vercel, VERCEL_URL is used if unset.
# APP_PUBLIC_URL=https://innohub.example.com

# Presigned S3 GET TTL (seconds) for feature-suggestion attachments when APP_PUBLIC_URL is unset (default 7 days).
# FEATURE_SUGGESTION_PRESIGN_SEC=604800

# Optional upload size cap (bytes). Default 250 MB.
# ADMIN_UPLOAD_MAX_BYTES=262144000

# --- Public site (contact + video order links) ------------------------------
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# NEXT_PUBLIC_CONTACT_TELEGRAM=https://t.me/your_handle
# APP_PUBLIC_URL=https://innohub.example.com

# FEATURE_SUGGESTION_MAX_FILES=5
# FEATURE_SUGGESTION_UPLOAD_MAX_BYTES=26214400

# --- Delivery for feature suggestions + video orders -------------------------
# `app/api/feature-suggestions/route.ts` and `app/api/video-orders/route.ts`
# currently just validate + rate-limit and respond 503 ("not configured") —
# no delivery integration is wired up yet.
# TODO: wire these up to YouGile (see YOUGILE_* below).

# --- YouGile (project chat, two-way sync) ---------------------------------
# Company + API key — chats are created in this company (the API key's company).
# See https://yougile.com/api-v2#/ ("Auth keys").
YOUGILE_COMPANY_ID=
YOUGILE_API_KEY=
# Run `node scripts/yougile-list-users.mjs` to list company users and pick
# ids for the two vars below.
# The site's own YouGile user (API key owner) — used to detect + skip
# webhook echoes of messages the site itself just sent.
YOUGILE_BOT_USER_ID=
# Comma-separated YouGile user ids added to every new project group chat
# (title: "Project name — writer@email"). They can reply to the user there.
YOUGILE_CHAT_MEMBER_IDS=
# Shared secret checked against ?token= on the webhook receiver
# (app/api/webhooks/yougile/route.ts). Generate with: openssl rand -hex 32
YOUGILE_WEBHOOK_SECRET=
# One-time setup once the vars above + APP_PUBLIC_URL are set:
#   node scripts/yougile-setup-webhook.mjs

# --- Email (Resend) — project sharing invites --------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. InnoHub <noreply@yourdomain.com>
RESEND_FROM=

# Optional shared secret for cron routes (/api/cron/storage-purge, /api/cron/storage-jobs,
# /api/cron/post-queue)
# CRON_SECRET=

# --- Автопостинг (docs/SOCIAL_POSTING_PLAN.md) ------------------------------
# Пояс, в котором считаются окно публикации и дни недели у нод-источников.
# Часы процесса на сервере — UTC, и без этой настройки «постить с 10 до 22»
# у человека в Москве превратилось бы в другие часы суток.
# По умолчанию Europe/Moscow.
# POSTING_TIME_ZONE=Europe/Moscow
#
# Тик автопостинга ставится в расписание рядом с storage-jobs:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://SITE/api/cron/post-queue
# Период — минута-две: сам обход папок ходит реже (настраивается в разделе
# «Автопостинг»), а тик ещё и продвигает очередь публикаций.

# --- Web Push (chat notifications) -----------------------------------------
# Generate once: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Public key is safe to expose (served via GET /api/push/vapid-public-key).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Выключатели частей сайта (docs/FEATURE_FLAGS.md) -----------------------
# Разница между основной площадкой и упрощённой копией держится на настройках, а
# не на удалённом коде: удали половину — и общие файлы разойдутся навсегда.
#
# Умолчание установки: чему равен флаг, о котором никто не принимал решения.
# На основной площадке не задано (= on), и новое приезжает включённым, как
# раньше. На копии — off: инструмент, приехавший туда с обновлением, остаётся
# погашенным, пока его не включат осознанно на /admin/features.
# FEATURE_DEFAULT=off
#
# Ниже — флаги, которые НЕЛЬЗЯ переключать из админки: они меняют саму
# установку, а не её настройку. Значения: on/off (true/false, 1/0, yes/no).
#
# Публичная витрина: `/`, `/videos`, `/video/<id>` и их роуты. Выключено — корень
# сайта ведёт на вход, а вошедшего сразу в кабинет (proxy.ts).
# FEATURE_PUBLIC_CATALOG=off
#
# Информационные страницы: /about, /contact, /suggest.
# FEATURE_PUBLIC_PAGES=off
#
# Биллинг: баланс, тарифы, подарки, тестовый период и проверка средств перед
# запуском задачи. В окружении, а не в админке, намеренно: гейт стоит в рабочем
# цикле конвейера, и переключение на ходу оставило бы незакрытые начисления.
# FEATURE_BILLING=off

# Имя площадки: шапка, подвал, меню, заголовок вкладки, письма-приглашения.
# Значок собирается из первых букв (FF Works → «FW»), отдельной переменной нет.
# NEXT_PUBLIC_, потому что имя стоит и в клиентских компонентах: подставляется
# на сборке, поэтому у каждой площадки своя сборка со своим значением.
# NEXT_PUBLIC_SITE_NAME=Моя площадка
